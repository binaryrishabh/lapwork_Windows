{
  "name": "lapwork",
  "version": "2.3.4",
  "description": "lapwork - personal productivity tracker",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "build:electron": "bun build electron/main.ts --outfile=electron/main.js --target=node --format=cjs --packages external && bun build electron/preload.ts --outfile=electron/preload.js --target=node --format=cjs --packages external",
    "dev": "bun run build:electron && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "start": "bun run build:electron && electron .",
    "dist": "bun run build:electron && bun run build && electron-builder --publish never",
    "build": "vite build"
  },
  "keywords": [],
  "author": "binaryrishabh",
  "license": "ISC",
  "dependencies": {
    "electron-updater": "^6.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.3",
    "sql.js": "^1.14.1",
    "uuid": "^14.0.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^10.0.5",
    "dotenv-cli": "^11.0.0",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "typescript": "^7.0.2",
    "vite": "^8.0.10",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.lapwork.app",
    "productName": "lapwork",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "build/icon.ico"
    ],
    "win": {
      "target": "nsis",
      "forceCodeSigning": false,
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "binaryrishabh",
      "repo": "lapwork_Windows"
    },
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      }
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/**/*"
    ]
  }
}
